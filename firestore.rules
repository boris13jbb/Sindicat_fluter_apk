rules_version = '2';
// Reglas para el Sistema de Voto Sindicato (Flutter).
// Despliega con: firebase deploy --only firestore

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== FUNCIONES AUXILIARES ====================
    
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function electionIsOpen(electionId) {
      let election = get(/databases/$(database)/documents/elections/$(electionId)).data;
      return (!(('isArchived' in election) && election.isArchived == true))
        && election.isActive == true
        && election.isVisibleToVoters == true
        && election.startDate is number
        && election.endDate is number
        && election.startDate <= request.time.toMillis()
        && election.endDate >= request.time.toMillis();
    }

    function candidateExists(electionId, candidateId) {
      return exists(/databases/$(database)/documents/elections/$(electionId)/candidates/$(candidateId));
    }

    function userVoteId(electionId) {
      return electionId + '_' + request.auth.uid;
    }

    function userVotePath(electionId) {
      return /databases/$(database)/documents/elections/$(electionId)/votes/$(userVoteId(electionId));
    }

    function ownVoteCreatedInRequest(electionId) {
      return !exists(userVotePath(electionId))
        && existsAfter(userVotePath(electionId))
        && getAfter(userVotePath(electionId)).data.electionId == electionId
        && getAfter(userVotePath(electionId)).data.userId == request.auth.uid;
    }
    
    // Obtener rol del usuario (maneja caso donde documento no existe)
    function getUserRole() {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userDocPath)
        ? get(userDocPath).data.role
        : 'USER';
    }
    
    // Verificar si es superadmin
    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'SUPERADMIN';
    }
    
    // Verificar si es admin o superadmin
    function isAdmin() {
      return isAuthenticated() && getUserRole() in ['SUPERADMIN', 'ADMIN'];
    }
    
    // Verificar si es operador de asistencia
    function isOperator() {
      return isAuthenticated() && getUserRole() in ['SUPERADMIN', 'ADMIN', 'OPERADOR_ASISTENCIA'];
    }

    function isActiveUser() {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated()
        && exists(userDocPath)
        && (!('isActive' in get(userDocPath).data) || get(userDocPath).data.isActive == true);
    }

    function userDocData() {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userDocPath) ? get(userDocPath).data : null;
    }

    function isLinkedToMember(memberId) {
      let user = userDocData();
      return user != null
        && 'memberId' in user
        && user.memberId is string
        && user.memberId == memberId;
    }

    function canReadMember(memberId) {
      return isAdmin() || isOperator() || isLinkedToMember(memberId);
    }

    function memberPath(memberId) {
      return /databases/$(database)/documents/members/$(memberId);
    }

    function memberMatchesEmployeeNumber(memberId, employeeNumber) {
      return memberId is string
        && employeeNumber is string
        && exists(memberPath(memberId))
        && (
          get(memberPath(memberId)).data.workerCode == employeeNumber ||
          get(memberPath(memberId)).data.memberNumber == employeeNumber ||
          get(memberPath(memberId)).data.documentId == employeeNumber
        );
    }

    function memberIsActive(memberId) {
      return exists(memberPath(memberId))
        && get(memberPath(memberId)).data.status in ['active', 'activo'];
    }

    // Elegibilidad electoral en servidor: usuario autenticado con socio activo vinculado.
    function authenticatedUserHasActiveMember() {
      let user = userDocData();
      return user != null
        && 'memberId' in user
        && user.memberId is string
        && user.memberId != ''
        && memberIsActive(user.memberId);
    }

    function voterMemberIdAssignmentAllowed(memberId, role) {
      return role != 'VOTER' || memberIsActive(memberId);
    }

    function validOptionalUserMemberId() {
      return !('memberId' in request.resource.data) ||
        request.resource.data.memberId == null ||
        (
          memberMatchesEmployeeNumber(
            request.resource.data.memberId,
            request.resource.data.employeeNumber
          ) &&
          voterMemberIdAssignmentAllowed(
            request.resource.data.memberId,
            request.resource.data.role
          )
        );
    }

    function validMemberIdBackfill() {
      return !changedKeys().hasAny(['memberId']) || (
        (!('memberId' in resource.data) ||
          resource.data.memberId == null ||
          resource.data.memberId == '') &&
        memberMatchesEmployeeNumber(
          request.resource.data.memberId,
          request.resource.data.employeeNumber
        ) &&
        voterMemberIdAssignmentAllowed(
          request.resource.data.memberId,
          request.resource.data.role
        )
      );
    }

    function validUserRole(role) {
      return role in ['SUPERADMIN', 'ADMIN', 'OPERADOR_ASISTENCIA', 'VOTER', 'USER'];
    }

    function validSuperAdminMemberIdAssignment() {
      return !changedKeys().hasAny(['memberId']) ||
        !('memberId' in request.resource.data) ||
        request.resource.data.memberId == null ||
        request.resource.data.memberId == '' ||
        (
          exists(memberPath(request.resource.data.memberId)) &&
          voterMemberIdAssignmentAllowed(
            request.resource.data.memberId,
            request.resource.data.role
          )
        );
    }

    function validSuperAdminUserUpdate() {
      return changedKeys().hasOnly([
          'role',
          'memberId',
          'employeeNumber',
          'displayName',
          'isActive',
          'updatedAt',
          'email',
          'gender',
          'avatarUrl',
          'avatarMode',
          'phoneNumber',
        ])
        && (!changedKeys().hasAny(['role']) ||
          validUserRole(request.resource.data.role))
        && (!changedKeys().hasAny(['isActive']) ||
          request.resource.data.isActive is bool)
        && validSuperAdminMemberIdAssignment();
    }

    function isValidAuditLogCreate() {
      return request.resource.data.keys().hasOnly([
          'action',
          'entityType',
          'entityId',
          'userId',
          'userName',
          'timestamp',
          'changes',
          'description',
          'platform',
          'ipAddress',
        ])
        && request.resource.data.keys().hasAll([
          'action',
          'entityType',
          'entityId',
          'userId',
          'timestamp',
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.action in [
          'create',
          'update',
          'delete',
          'vote',
          'import_',
          'login',
          'logout',
          'attendance',
        ]
        && request.resource.data.entityType in [
          'member',
          'election',
          'candidate',
          'vote',
          'attendanceEvent',
          'attendanceRecord',
          'user',
          'import_',
        ]
        && request.resource.data.entityId is string
        && request.resource.data.timestamp is number
        && (!('userName' in request.resource.data) ||
          request.resource.data.userName == null ||
          request.resource.data.userName is string)
        && (!('description' in request.resource.data) ||
          request.resource.data.description == null ||
          request.resource.data.description is string)
        && (!('platform' in request.resource.data) ||
          request.resource.data.platform == null ||
          request.resource.data.platform is string)
        && (!('ipAddress' in request.resource.data) ||
          request.resource.data.ipAddress == null ||
          request.resource.data.ipAddress is string)
        && (!('changes' in request.resource.data) ||
          request.resource.data.changes == null ||
          request.resource.data.changes is map);
    }

    // ==================== USUARIOS ====================
    
    match /users/{userId} {
      // get: propio documento o superadmin.
      // list: solo superadmin (evita enumeración de cuentas).
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      
      // Crear: auto-registro solo como votante, sin escalación de privilegios
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'role',
          'employeeNumber',
          'memberId',
          'createdAt',
          'updatedAt',
          'isActive',
          'gender',
          'avatarUrl',
          'avatarMode',
          'phoneNumber',
        ])
        && request.resource.data.keys().hasAll(['email', 'role'])
        && request.resource.data.email is string
        && request.resource.data.role == 'VOTER'
        && (!('displayName' in request.resource.data) ||
          request.resource.data.displayName == null ||
          request.resource.data.displayName is string)
        && (!('employeeNumber' in request.resource.data) ||
          request.resource.data.employeeNumber == null ||
          request.resource.data.employeeNumber is string)
        && (!('gender' in request.resource.data) ||
          request.resource.data.gender == null ||
          request.resource.data.gender is string)
        && (!('avatarUrl' in request.resource.data) ||
          request.resource.data.avatarUrl == null ||
          request.resource.data.avatarUrl is string)
        && (!('avatarMode' in request.resource.data) ||
          request.resource.data.avatarMode == null ||
          request.resource.data.avatarMode is string)
        && (!('phoneNumber' in request.resource.data) ||
          request.resource.data.phoneNumber == null ||
          request.resource.data.phoneNumber is string)
        && validOptionalUserMemberId();
      
      // Actualizar: superadmin puede administrar roles/estado/vinculación;
      // el usuario solo puede actualizar su perfil sin cambiar rol.
      allow update: if (isSuperAdmin() && validSuperAdminUserUpdate()) || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        changedKeys().hasOnly([
          'email',
          'displayName',
          'employeeNumber',
          'memberId',
          'updatedAt',
          'gender',
          'avatarUrl',
          'avatarMode',
          'phoneNumber',
        ])
        && validMemberIdBackfill()
      );
      
      // Eliminar: solo superadmin
      allow delete: if isSuperAdmin();
    }

    // ==================== SOCIOS (MEMBERS) ====================
    
    match /members/{memberId} {
      // get: admin, operador o socio vinculado a su propia ficha.
      // list: solo roles con funciones administrativas/operativas.
      allow get: if isAuthenticated() && canReadMember(memberId);
      allow list: if isAdmin() || isOperator();
      allow create: if isAdmin();
      allow update: if isSuperAdmin() || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ==================== ELECCIONES ====================

    match /elections/{electionId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      
      // Permitir actualización parcial solo para campos de conteo de votos
      // Esto permite que usuarios VOTER incrementen totalVotes sin poder modificar otros campos
      allow update: if isAdmin() || (
        isActiveUser() &&
        electionIsOpen(electionId) &&
        ownVoteCreatedInRequest(electionId) &&
        changedKeys().hasOnly(['totalVotes', 'updatedAt']) &&
        request.resource.data.totalVotes is number &&
        request.resource.data.totalVotes == resource.data.totalVotes + 1 &&
        request.resource.data.updatedAt is number
      );
      
      allow delete: if isSuperAdmin();

      // Candidatos
      match /candidates/{candidateId} {
        allow read: if isAuthenticated();
        allow create: if isAdmin();
        
        // Permitir actualización parcial solo para campo voteCount
        // Esto permite que usuarios VOTER incrementen voteCount sin poder modificar otros campos
        allow update: if isAdmin() || (
          isActiveUser() &&
          electionIsOpen(electionId) &&
          ownVoteCreatedInRequest(electionId) &&
          getAfter(userVotePath(electionId)).data.candidateId == candidateId &&
          changedKeys().hasOnly(['voteCount']) &&
          request.resource.data.voteCount is number &&
          request.resource.data.voteCount == resource.data.voteCount + 1
        );
        
        allow delete: if isSuperAdmin();
      }

      // Votos
      match /votes/{voteId} {
        // Cualquier usuario autenticado puede verificar si ya votó (leer su propio voto)
        // Admin/superadmin pueden leer todos los votos para reportes
        allow read: if isAdmin() || (
          isAuthenticated() &&
          voteId == userVoteId(electionId)
        );
        allow create: if isActiveUser()
                && authenticatedUserHasActiveMember()
                && request.resource.data.keys().hasOnly([
                  'electionId',
                  'userId',
                  'candidateId',
                  'votedAt',
                ])
                && electionIsOpen(electionId)
                && request.resource.data.electionId == electionId
                && request.resource.data.userId == request.auth.uid
                && request.resource.data.candidateId is string
                && candidateExists(electionId, request.resource.data.candidateId)
                && request.resource.data.votedAt == request.time
                && voteId == userVoteId(electionId);
        allow update, delete: if false; // Los votos son inmutables
      }
    }

    // ==================== EVENTOS DE ASISTENCIA ====================

    // Cliente NUNCA puede escribir SECURE_QR_V2 (solo Admin SDK / Functions).
    function isSecureQrV2Method(data) {
      return ('metodoRegistro' in data)
        && data.metodoRegistro == 'SECURE_QR_V2';
    }

    // Override excepcional: motivo obligatorio + actor = auth.uid.
    function isValidManualOverrideCreate() {
      return request.resource.data.metodoRegistro == 'MANUAL_OVERRIDE'
        && request.resource.data.personaId is string
        && request.resource.data.personaId.size() > 0
        && request.resource.data.justificacion is string
        && request.resource.data.justificacion.size() >= 3
        && request.resource.data.registradoPor is string
        && request.resource.data.registradoPor == request.auth.uid;
    }

    // Métodos legacy de cliente (QR/barcode/manual clásico). No incluyen secure.
    function isLegacyClientAttendanceMethod() {
      return !('metodoRegistro' in request.resource.data)
        || request.resource.data.metodoRegistro in [
          'MANUAL', 'ESCANEO_QR', 'ESCANEO_BARCODE'
        ];
    }

    function canClientCreateAttendance() {
      return isOperator()
        && !isSecureQrV2Method(request.resource.data)
        && (
          isLegacyClientAttendanceMethod()
          || isValidManualOverrideCreate()
        );
    }

    function canClientUpdateAttendance() {
      return isOperator()
        && !isSecureQrV2Method(request.resource.data)
        && !isSecureQrV2Method(resource.data)
        && (
          // No elevar a MANUAL_OVERRIDE sin justificación
          request.resource.data.metodoRegistro != 'MANUAL_OVERRIDE'
          || (
            request.resource.data.justificacion is string
            && request.resource.data.justificacion.size() >= 3
            && request.resource.data.registradoPor == request.auth.uid
          )
        );
    }
    
    // Sistema nuevo: attendance_events con subcolecciones
    match /attendance_events/{eventId} {
      allow read: if isAuthenticated();
      // Alta alineada con eventos legacy: admin y operador de asistencia
      allow create: if isOperator();
      allow update: if isOperator();
      allow delete: if isSuperAdmin();

      // Asistencias del evento
      match /asistencias/{asistenciaId} {
        allow read: if isAuthenticated();
        allow create: if canClientCreateAttendance();
        allow update: if canClientUpdateAttendance();
        allow delete: if isSuperAdmin();
      }
    }

    // ==================== EVENTOS ANTIGUOS ====================
    // Colecciones legacy para compatibilidad con Android
    
    match /eventos/{eventoId} {
      allow read: if isAuthenticated();
      allow create, update: if isOperator();
      allow delete: if isSuperAdmin();

      match /asistencias/{asistenciaId} {
        allow read: if isAuthenticated();
        allow create: if canClientCreateAttendance();
        allow update: if canClientUpdateAttendance();
        allow delete: if isSuperAdmin();
      }
    }

    match /personas/{personaId} {
      allow read: if isAuthenticated();
      allow create, update: if isOperator();
      allow delete: if isSuperAdmin();
    }

    match /asistencias/{asistenciaId} {
      allow read: if isAuthenticated();
      allow create: if canClientCreateAttendance();
      allow update: if canClientUpdateAttendance();
      allow delete: if isSuperAdmin();
    }

    // Secure Attendance QR V2 — device registries (backend-only writes)
    match /attendance_member_devices/{deviceId} {
      allow read: if isAuthenticated()
        && (
          isAdmin()
          || isOperator()
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberId == resource.data.memberId)
        );
      allow create, update, delete: if false;
    }

    match /attendance_scanner_devices/{scannerId} {
      allow read: if isAuthenticated() && (isAdmin() || isOperator());
      allow create, update, delete: if false;
    }

    // Lectura explícita para consultas collectionGroup('asistencias') usadas
    // por resúmenes de asistencia. Las escrituras permanecen restringidas en
    // las reglas específicas de cada colección/subcolección.
    match /{path=**}/asistencias/{asistenciaId} {
      allow read: if isAuthenticated();
    }

    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create, update: if isOperator();
      allow delete: if isSuperAdmin();
    }

    // ==================== REGISTROS DE AUDITORÍA ====================
    
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isValidAuditLogCreate(); // Solo append
      allow update, delete: if false; // Inmutables
    }

    // ==================== LOGS DE IMPORTACIÓN ====================
    
    match /import_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ==================== CONFIGURACIÓN APP (marca PDF, solo superadmin) ====================

    match /app_settings/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSuperAdmin()
        && docId == 'branding'
        && request.resource.data.keys().hasOnly(['reportLogoUrl', 'updatedAt', 'updatedBy'])
        && request.resource.data.reportLogoUrl is string
        && request.resource.data.reportLogoUrl.size() <= 2048
        && (request.resource.data.reportLogoUrl == ''
          || request.resource.data.reportLogoUrl.matches('https://.*'))
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // ==================== REGLA POR DEFECTO ====================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
